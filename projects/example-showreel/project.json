      {
        "technique": "montage",
        "beats": 7,
        "lines": [
          "LAUNCHES",
          "DATA",
          "LOOPS",
          "ADS",
          "STINGS"
        ],
        "text": "FRAME PERFECT",
        "transition": "cut"
      },
      {
        "technique": "formats",
        "beats": 5,
        "field": "bg",
        "transition": "cut"
      },
      {
        "technique": "end",
        "beats": 4,
        "text": "REELCODE",
