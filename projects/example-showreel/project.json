{
  "$schema": "../../docs/project.schema.json",
  "template": "showreel",
  "title": "Studio reel",
  "brand": {
    "name": "reelcode",
    "colors": {
      "bg": "#0C0C0D",
      "fg": "#F3F0E8",
      "accent": "#C8F23C"
    },
    "fonts": {
      "display": {
        "family": "\"Archivo Condensed\", sans-serif",
        "weight": 800,
        "tracking": -0.02
      },
      "ui": {
