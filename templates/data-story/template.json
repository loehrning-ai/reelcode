{
  "id": "data-story",
  "description": "Animated data story from content: hero spine (growth or decline), bar chart race, filmed self-drawing line, comparison tracks, 24-hour clock, kinetic lockup; identity-carrying hand-offs between shots; locale-formatted numbers.",
  "requires": [],
  "defaults": {
    "duration": 20, "bpm": 120, "loop": false, "seed": 7, "quality": "draft",
    "formats": ["9x16", "1x1", "4x5", "16x9"],
    "audio": { "music": "synth", "style": "ambient-cinematic", "key": "D minor", "sfx": true, "sfxDensity": "normal", "lufs": -14 }
  },
  "content_schema": {
    "type": "object",
    "required": ["points", "takeaway"],
    "additionalProperties": false,
    "properties": {
      "locale": { "type": "string", "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$", "description": "BCP 47 tag for every number (grouping, decimals, %, currency, compact). Default en-US." },
      "kicker": { "type": "string", "minLength": 1, "maxLength": 24, "description": "Accent chip on the opening, e.g. SAMPLE DATA." },
      "title": { "type": "string", "minLength": 1, "maxLength": 64, "description": "Not drawn on the opening. Shown only as the end card's small line when content.source is missing; set source for the citation line." },
      "hero": {
        "type": "object", "required": ["value"], "additionalProperties": false,
        "description": "Opening big number. Omit it to open on the first point.",
        "properties": {
          "value": { "type": "number" }, "from": { "type": "number" },
          "label": { "type": "string", "minLength": 1, "maxLength": 80 }, "accent": { "type": "string" },
          "sub": { "type": "string", "minLength": 1, "maxLength": 120, "description": "Deprecated: no longer drawn (the exact figure belongs in source)." },
          "fmt": { "type": "string", "enum": ["int", "pct", "money", "compact", "x"] },
          "decimals": { "type": "integer", "minimum": 0, "maximum": 4 },
          "unit": { "type": "string", "maxLength": 12 }, "prefix": { "type": "string", "maxLength": 6 },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "beats": { "type": "number", "minimum": 4, "maximum": 32, "description": "Hero length in beats (default 5: shot A 0-2, smash cut to shot B on beat 2)." },
          "fromLabel": { "type": ["integer", "string"], "description": "Period of hero.from (e.g. 2021), shown from frame 0; integers roll with the count." },
          "toLabel": { "type": ["integer", "string"], "description": "Period of hero.value (e.g. 2025)." },
          "delta": { "type": "string", "enum": ["ratio", "none"], "description": "Change chip after the landing: value / from for growth (2.6×), the % change for a decline (−22%). Default ratio when from > 0." },
          "deltaLabel": { "type": "string", "maxLength": 32, "description": "Text after the ratio in the growth chip." }
        }
      },
      "points": {
        "type": "array", "minItems": 1, "maxItems": 6,
        "items": {
          "type": "object", "required": ["type", "claim"], "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["bars", "race", "line", "compare", "counter"] },
            "claim": { "type": "string", "minLength": 1, "maxLength": 90 },
            "accent": { "type": "string", "description": "A word of the claim to set in the accent colour." },
            "kicker": { "type": "string", "maxLength": 24, "description": "Replaces the default '02 / 05' index above the claim." },
            "beats": { "type": "number", "minimum": 4, "maximum": 48, "description": "Override the scene length (beats). Default is derived from the data." },
            "fmt": { "type": "string", "enum": ["int", "pct", "money", "compact", "x"] },
            "decimals": { "type": "integer", "minimum": 0, "maximum": 4 },
            "unit": { "type": "string", "maxLength": 12 }, "prefix": { "type": "string", "maxLength": 6 },
            "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
            "data": {
              "type": "array", "minItems": 2, "maxItems": 24,
              "description": "bars: [{label, value}] (2-8). line: [{x, y}] (3-24).",
              "items": { "type": "object", "additionalProperties": false, "properties": {
                "label": { "type": ["string", "number"], "maxLength": 14 }, "value": { "type": "number" },
                "x": { "type": ["string", "number"], "maxLength": 10 }, "y": { "type": "number" } } }
            },
            "highlight": { "type": ["integer", "string"], "description": "bars: label or index; race: key or index." },
            "keys": { "type": "array", "minItems": 2, "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 16 } },
            "frames": {
              "type": "array", "minItems": 2, "maxItems": 10,
              "items": { "type": "object", "required": ["label", "values"], "additionalProperties": false, "properties": {
                "label": { "type": ["string", "number"] }, "values": { "type": "array", "minItems": 2, "maxItems": 8, "items": { "type": "number", "minimum": 0 } } } }
            },
            "step": { "type": "number", "minimum": 1, "maximum": 8, "description": "race: beats per frame (default 2)." },
            "annotations": {
              "type": "array", "maxItems": 4,
              "items": { "type": "object", "required": ["at", "text"], "additionalProperties": false, "properties": {
                "at": { "type": ["integer", "string"], "description": "data index or x label" }, "text": { "type": "string", "minLength": 1, "maxLength": 40 } } }
            },
            "drawBeats": { "type": "number", "minimum": 2, "maximum": 12, "description": "line: beats for the draw-on (default 4)." },
            "zero": { "type": "boolean", "description": "line: start the y axis at 0 (default true)." },
            "items": {
              "type": "array", "minItems": 2, "maxItems": 2,
              "items": { "type": "object", "required": ["label", "value"], "additionalProperties": false, "properties": {
                "label": { "type": "string", "minLength": 1, "maxLength": 20 }, "value": { "type": "number", "minimum": 0 } } }
            },
            "delta": { "type": "string", "enum": ["ratio", "pct", "diff", "none"] },
            "deltaLabel": { "type": "string", "maxLength": 28 },
            "value": { "type": "number" }, "from": { "type": "number" },
            "label": { "type": "string", "minLength": 1, "maxLength": 80 }
          }
        }
      },
      "takeaway": { "type": "string", "minLength": 1, "maxLength": 90 },
      "takeawayAccent": { "type": "string" },
      "source": { "type": "string", "maxLength": 160 }
    }
  },
  "example": {
    "title": "Harbor City bike share (sample data)",
    "duration": 20,
    "brand": {
      "name": "Harbor City Mobility Lab",
      "colors": { "bg": "#0F1417", "fg": "#EEEAE2", "accent": "#FFB341" },
      "fonts": {
        "display": { "family": "\"Archivo Condensed\", sans-serif", "weight": 700, "tracking": -0.02 },
        "ui": { "family": "Inter, sans-serif", "weight": 500, "tracking": 0.01 }
      }
    },
    "content": {
      "locale": "en-US",
      "kicker": "SAMPLE",
      "title": "Harbor City bike share, 2021–2025",
      "hero": { "value": 4218500, "from": 1600000, "fmt": "compact", "decimals": 1, "fromLabel": 2021, "toLabel": 2025, "label": "bike-share trips", "accent": "trips" },
      "points": [
        { "type": "race", "claim": "Riverside overtook the old centre", "accent": "Riverside", "unit": "k",
          "keys": ["Old Town", "Riverside", "Docklands", "Northgate", "Hillcrest"], "highlight": "Riverside",
          "frames": [
            { "label": 2021, "values": [520, 310, 260, 300, 180] },
            { "label": 2022, "values": [560, 430, 330, 320, 210] },
            { "label": 2023, "values": [590, 560, 410, 340, 250] },
            { "label": 2024, "values": [610, 690, 480, 350, 300] },
            { "label": 2025, "values": [630, 820, 560, 370, 340] } ] },
        { "type": "line", "claim": "Weekly riders climbed all year", "accent": "climbed", "fmt": "compact", "drawBeats": 6,
          "data": [ { "x": "Jan", "y": 52000 }, { "x": "Feb", "y": 55000 }, { "x": "Mar", "y": 64000 }, { "x": "Apr", "y": 71000 },
            { "x": "May", "y": 79000 }, { "x": "Jun", "y": 86000 }, { "x": "Jul", "y": 78000 }, { "x": "Aug", "y": 84000 },
            { "x": "Sep", "y": 90000 }, { "x": "Oct", "y": 99000 }, { "x": "Nov", "y": 101000 }, { "x": "Dec", "y": 104000 } ],
          "annotations": [ { "at": "Mar", "text": "Protected lanes open" }, { "at": "Jul", "text": "Heatwave dip" }, { "at": "Oct", "text": "Student pass" } ] },
        { "type": "compare", "claim": "E-bike trips run longer", "accent": "longer", "decimals": 1, "unit": " km",
          "items": [ { "label": "E-bike", "value": 5.8 }, { "label": "Classic", "value": 2.4 } ], "delta": "ratio", "deltaLabel": "longer per trip" },
        { "type": "bars", "claim": "The morning peak carries the load", "accent": "morning", "highlight": "6–9",
          "data": [ { "label": "6–9", "value": 1240 }, { "label": "9–12", "value": 610 }, { "label": "12–15", "value": 540 },
            { "label": "15–18", "value": 980 }, { "label": "18–21", "value": 720 }, { "label": "21–24", "value": 260 } ] }
      ],
      "takeaway": "Build the lanes and the riders follow.",
      "takeawayAccent": "riders",
      "source": "Source: fictional sample data. Harbor City is not a real place."
    }
  }
}
