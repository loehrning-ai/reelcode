{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reelcode/project.v1",
  "title": "reelcode project.json",
  "description": "Validated by engine/schema.js (subset: type, required, properties, additionalProperties(bool or schema), items, enum, const, pattern, minimum, maximum, minItems, maxItems, minLength, maxLength, default). Template defaults, brand presets (brands/<id>.json), the selected variant and cutdown are applied before validation; content is validated separately against templates/<template>/template.json content_schema. A project names exactly one of template or page (checked in code), and content is required with a template (checked in code).",
  "type": "object",
  "required": [
    "title",
    "formats",
    "brand"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "template": {
      "type": "string",
      "pattern": "^_?[a-z0-9][a-z0-9-]*$",
      "description": "A folder in templates/. Exactly one of template or page."
    },
    "page": {
      "type": "string",
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9_][A-Za-z0-9_./-]*\\.html$",
      "description": "Bespoke page (relative to the project) for a one-off film: honours window.seek(t), canvas #c and ?project&format&w&h&mode&variant&cutdown. Exactly one of template or page."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "default": 7
    },
    "duration": {
      "type": "number",
      "minimum": 2,
      "maximum": 180,
      "description": "Seconds; snapped to whole bars: totalBeats = 4*round(duration*bpm/240). Shared by every format (no per-format duration; use cutdowns)."
    },
    "bpm": {
      "type": "number",
      "minimum": 60,
      "maximum": 180
    },
    "loop": {
      "type": "boolean",
      "default": false
    },
    "formats": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "string",
        "enum": [
          "9x16",
          "1x1",
          "4x5",
          "16x9"
        ]
      }
    },
    "brand": {
      "type": [
        "string",
        "object"
      ],
      "required": [
        "colors",
        "fonts"
      ],
      "additionalProperties": false,
      "properties": {
        "extends": {
          "type": "string",
          "pattern": "^@[a-z0-9][a-z0-9-]{0,40}$",
          "description": "Brand preset to start from (brands/<id>.json); removed after expansion."
        },
        "name": {
          "type": "string"
        },
        "colors": {
          "type": "object",
          "required": [
            "bg",
            "fg",
            "accent"
          ],
          "additionalProperties": false,
          "properties": {
            "bg": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "fg": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "accent": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "muted": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "surface": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "accent2": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "description": "Only honoured when brand.multiAccent is true."
            }
          }
        },
        "multiAccent": {
          "type": "boolean",
          "default": false
        },
        "fonts": {
          "type": "object",
          "required": [
            "display",
            "ui"
          ],
          "additionalProperties": false,
          "properties": {
            "display": {
              "type": "object",
              "required": [
                "family"
              ],
              "additionalProperties": false,
              "properties": {
                "family": {
                  "type": "string",
                  "minLength": 1
                },
                "weight": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 900,
                  "default": 800
                },
                "tracking": {
                  "type": "number",
                  "minimum": -0.1,
                  "maximum": 0.3,
                  "default": -0.03
                }
              }
            },
            "ui": {
              "type": "object",
              "required": [
                "family"
              ],
              "additionalProperties": false,
              "properties": {
                "family": {
                  "type": "string",
                  "minLength": 1
                },
                "weight": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 900,
                  "default": 400
                },
                "tracking": {
                  "type": "number",
                  "minimum": -0.1,
                  "maximum": 0.3,
                  "default": 0.02
                }
              }
            }
          }
        },
        "logo": {
          "type": "string",
          "pattern": "^(assets/|brands/[a-z0-9][a-z0-9-]*/)[^.][^\\s]*\\.(png|svg|jpg|jpeg|webp)$",
          "description": "Project-relative (assets/...) or a preset file (brands/<id>/...)."
        },
        "radius": {
          "type": "number",
          "minimum": 0,
          "maximum": 200
        },
        "springs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "soft": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "minimum": 0.01,
                "maximum": 10
              }
            },
            "med": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "minimum": 0.01,
                "maximum": 10
              }
            },
            "stiff": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "minimum": 0.01,
                "maximum": 10
              }
            },
            "snap": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "minimum": 0.01,
                "maximum": 10
              }
            }
          },
          "description": "Override the named spring presets. Each is [response, damping]: response = seconds for one swing of the undamped spring, damping = damping ratio (1 = no overshoot, < 1 overshoots)."
        }
      },
      "pattern": "^@[a-z0-9][a-z0-9-]{0,40}$",
      "description": "\"@id\" (brands/<id>.json) or an object; {extends:\"@id\", ...partial} deep-merges the partial onto the preset. Validated after the presets are expanded."
    },
    "fonts": {
      "type": "array",
      "maxItems": 8,
      "description": "Font files of this project, loaded before the first frame, so a brand can use its own typeface. A brand family that is neither bundled, installed nor listed here is a boot error. Every entry states the licence that allows rendering the font into video; make copies it into out/manifest.json.",
      "items": {
        "type": "object",
        "required": [
          "family",
          "file",
          "licence"
        ],
        "additionalProperties": false,
        "properties": {
          "family": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9 _-]{0,63}$",
            "description": "The name brand.fonts.*.family uses, e.g. \"Brand Sans\"."
          },
          "file": {
            "type": "string",
            "pattern": "^(?!.*\\.\\.)(?!out/)(?!audio/)[A-Za-z0-9_][A-Za-z0-9_./-]*\\.(woff2|woff|ttf|otf)$",
            "description": "Project-relative font file (woff2, woff, ttf or otf). assets/ is git-ignored, so a font you may not redistribute stays out of the repository."
          },
          "weight": {
            "type": [
              "integer",
              "string"
            ],
            "minimum": 1,
            "maximum": 1000,
            "pattern": "^[1-9][0-9]{0,2}( [1-9][0-9]{0,3})?$",
            "description": "400, or a range for a variable font: \"100 900\". Default 400."
          },
          "style": {
            "type": "string",
            "enum": [
              "normal",
              "italic"
            ],
            "default": "normal"
          },
          "licence": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200,
            "description": "Required: the licence that allows this use, as an SPDX id (OFL-1.1) or a short statement (\"Commercial desktop licence incl. video, Acme GmbH\")."
          }
        }
      }
    },
    "assets": {
      "type": "object",
      "description": "id -> project-relative path under assets/.",
      "additionalProperties": true
    },
    "clips": {
      "type": "object",
      "description": "id -> local video clip, pre-extracted to a PNG sequence (assets/clips/<id>/) by engine/cli/lib/clips.mjs (deterministic seek). src must stay inside the project.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "src"
        ],
        "additionalProperties": false,
        "properties": {
          "src": {
            "type": "string",
            "minLength": 1,
            "description": "Project-relative video file (not under assets/clips/)."
          },
          "from": {
            "type": "number",
            "minimum": 0,
            "description": "In-point, seconds (default 0)."
          },
          "to": {
            "type": "number",
            "minimum": 0,
            "description": "Out-point, seconds (default: clip end)."
          },
          "fps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120,
            "description": "Extraction rate (default 30)."
          },
          "width": {
            "type": "integer",
            "minimum": 16,
            "maximum": 3840,
            "description": "Extraction width in px (height keeps the aspect)."
          }
        }
      }
    },
    "prepare": {
      "type": "array",
      "maxItems": 16,
      "description": "Generator steps make runs before anything else, so a project ships as text and builds its own assets (procedural images, a sectioned score, UI captures). Each step has exactly one of run or capture.",
      "items": {
        "type": "object",
        "required": [
          "creates"
        ],
        "additionalProperties": false,
        "properties": {
          "run": {
            "type": "string",
            "pattern": "^(?!.*\\.\\.)(\\./)?[A-Za-z0-9_][A-Za-z0-9_./-]*\\.py$",
            "description": "Python script, relative to the repository root (or to the project when it starts with ./), run with the reelcode venv python (-I) from the repository root."
          },
          "capture": {
            "type": "string",
            "minLength": 1,
            "description": "capture source (fixture:<name>, http://localhost:PORT/..., http://127.0.0.1:PORT/... or a local .html file); runs reelcode capture into this project."
          },
          "args": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string"
            },
            "description": "Arguments. {project} expands to the project folder, {plan} to the planning copy (see plan)."
          },
          "creates": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "string",
              "pattern": "^(?!.*\\.\\.)[A-Za-z0-9_][A-Za-z0-9_./-]*$"
            },
            "description": "Project-relative files the step writes. The step runs only when one of them is missing (make --force reruns it)."
          },
          "plan": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "audio": {
                "type": "object"
              }
            },
            "description": "Run make --only audio on a temporary copy of the project with these settings first (for example {\"audio\": {\"music\": \"synth\"}}), so a score generator can read its out/timeline.json and audio/cues.json via {plan}."
          }
        }
      }
    },
    "content": {
      "type": "object",
      "description": "Template-specific; validated by template.json content_schema."
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "music": {
          "type": "string",
          "minLength": 1,
          "description": "\"synth\", \"none\" (no music bed: sfx and voice-over only, on the nominal grid) or a project-relative path to a supplied track (e.g. audio/track.wav)."
        },
        "musicStart": {
          "type": "number",
          "minimum": 0,
          "default": 0,
          "description": "Supplied track only: seconds cut from the start (exact sample); beats are measured after the cut. make warns when it is not on a downbeat."
        },
        "fit": {
          "type": "string",
          "enum": [
            "trim",
            "loop",
            "fade-bar"
          ],
          "description": "Supplied track only (engine/audio/fit.py): trim = cut at the film end (refuses a short track); loop = repeat whole bars to fill; fade-bar = fade across the last bar (refused for loop:true films). Omitted: the track is used as is."
        },
        "style": {
          "type": "string",
          "enum": [
            "minimal-tech",
            "punchy-pop",
            "ambient-cinematic",
            "lofi"
          ]
        },
        "key": {
          "type": "string",
          "pattern": "^[A-G](#|b)? (major|minor)$"
        },
        "sfx": {
          "type": "boolean",
          "default": true
        },
        "sfxDensity": {
          "type": "string",
          "enum": [
            "sparse",
            "normal",
            "busy"
          ],
          "default": "normal"
        },
        "lufs": {
          "type": "number",
          "minimum": -24,
          "maximum": -9,
          "default": -14
        },
        "voiceover": {
          "type": "object",
          "additionalProperties": false,
          "description": "Voice-over (engine/cli/lib/voiceover.mjs buildVoiceover). Ducks music+sfx under the voice.",
          "properties": {
            "engine": {
              "type": "string",
              "enum": [
                "say",
                "file",
                "elevenlabs"
              ],
              "description": "Required. file = your own recording inside the project (segments from <stem>.segments.json, else detected speech paired with lines); elevenlabs = remote TTS, only when the ELEVENLABS_API_KEY environment variable is set (never in project.json or a file); say = local macOS TTS, one synthesis per line (cached in audio/.voice-cache/). Apple licenses the macOS voices for personal, non-commercial use only: never publish say audio."
            },
            "voice": {
              "type": "string",
              "minLength": 1,
              "description": "Engine voice name (say: \"say -v ?\" lists local voices, default Samantha; an unknown say voice is an error)."
            },
            "file": {
              "type": "string",
              "pattern": "^(?!.*\\.\\.)[A-Za-z0-9_][A-Za-z0-9_./-]*\\.(wav|aiff|aif|mp3|m4a)$",
              "description": "engine:\"file\": project-relative recording."
            },
            "lines": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "required": [
                  "text"
                ],
                "additionalProperties": false,
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400
                  },
                  "at": {
                    "type": [
                      "number",
                      "string",
                      "object"
                    ],
                    "pattern": "^(b-?\\d+(\\.\\d+)?|bar\\d+(\\.\\d+)?|s-?\\d+(\\.\\d+)?)$",
                    "description": "Time ref (beats; \"b3.5\" | \"bar2\" | \"s1.25\") from the film start, or {scene, at} local to a scene, which follows the scene in every cutdown (a line whose scene a cutdown drops is dropped there). Default: after the previous line.",
                    "required": [
                      "scene"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "scene": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Scene id (out/timeline.json)."
                      },
                      "at": {
                        "type": [
                          "number",
                          "string"
                        ],
                        "pattern": "^(b-?\\d+(\\.\\d+)?|bar\\d+(\\.\\d+)?|s-?\\d+(\\.\\d+)?)$",
                        "description": "Time ref local to the scene (default 0)."
                      }
                    }
                  }
                }
              }
            },
            "duck_db": {
              "type": "number",
              "minimum": -30,
              "maximum": 0,
              "default": -9,
              "description": "Music+sfx gain under the voice."
            }
          },
          "required": [
            "engine"
          ]
        }
      }
    },
    "captions": {
      "type": "object",
      "additionalProperties": false,
      "description": "Burned-in captions (engine/captions.js drawCaptions) and SRT/VTT sidecars (engine/cli/lib/captions.mjs writeSidecars).",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Draw captions on the picture."
        },
        "style": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$",
          "default": "clean"
        },
        "source": {
          "type": "string",
          "enum": [
            "voiceover",
            "manual"
          ],
          "default": "voiceover"
        },
        "sidecars": {
          "type": "boolean",
          "default": true,
          "description": "Write captions.srt and captions.vtt next to the videos."
        },
        "lines": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "required": [
              "text",
              "at"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "at": {
                "type": [
                  "number",
                  "string"
                ],
                "pattern": "^(b-?\\d+(\\.\\d+)?|bar\\d+(\\.\\d+)?|s-?\\d+(\\.\\d+)?)$"
              },
              "end": {
                "type": [
                  "number",
                  "string"
                ],
                "pattern": "^(b-?\\d+(\\.\\d+)?|bar\\d+(\\.\\d+)?|s-?\\d+(\\.\\d+)?)$"
              }
            }
          }
        }
      }
    },
    "poster": {
      "type": [
        "number",
        "string"
      ],
      "pattern": "^(b\\d+(\\.\\d+)?|bar\\d+|s\\d+(\\.\\d+)?)$",
      "description": "Time ref: number = beats, or \"b3.5\" | \"bar2\" | \"s1.25\". The pattern applies to string values only."
    },
    "quality": {
      "type": "string",
      "enum": [
        "draft",
        "final"
      ],
      "default": "draft"
    },
    "variants": {
      "type": "array",
      "maxItems": 24,
      "description": "Alternate versions of the same film (language, audience, brand). make --variant <id>|all. Output: out/<variant>/<cutdown>/<fmt>/.",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
            "description": "\"main\" is reserved for the project itself."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "overrides": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "content": {
                "type": "object"
              },
              "brand": {
                "type": [
                  "string",
                  "object"
                ],
                "pattern": "^@[a-z0-9][a-z0-9-]{0,40}$"
              },
              "audio": {
                "type": "object"
              },
              "captions": {
                "type": "object"
              },
              "exports": {
                "type": "array",
                "maxItems": 9,
                "items": {
                  "type": "string",
                  "enum": [
                    "720p",
                    "4k",
                    "webm",
                    "gif",
                    "prores-alpha",
                    "tiktok",
                    "reels",
                    "youtube",
                    "linkedin"
                  ]
                },
                "description": "Replaces project.exports for this variant (e.g. [] for a demo variant that needs no prores-alpha)."
              },
              "transparent": {
                "type": "boolean",
                "description": "Replaces project.transparent for this variant (a demo over footage is opaque)."
              }
            }
          }
        }
      }
    },
    "cutdowns": {
      "type": "array",
      "maxItems": 12,
      "description": "Shorter edits rebuilt from the same scenes. make --cutdown <id>|all. keep: scene ids (in film order) or \"auto\".",
      "items": {
        "type": "object",
        "required": [
          "id",
          "duration"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
            "description": "\"full\" is reserved for the uncut film."
          },
          "duration": {
            "type": "number",
            "minimum": 2,
            "maximum": 180,
            "description": "Seconds, snapped to whole bars like project.duration."
          },
          "keep": {
            "type": [
              "string",
              "array"
            ],
            "pattern": "^auto$",
            "default": "auto",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "poster": {
            "type": [
              "number",
              "string"
            ],
            "pattern": "^(b\\d+(\\.\\d+)?|bar\\d+|s\\d+(\\.\\d+)?)$"
          }
        }
      }
    },
    "exports": {
      "type": "array",
      "maxItems": 9,
      "description": "Extra deliverables per format (engine/cli/lib/exporter.mjs exportPresets).",
      "items": {
        "type": "string",
        "enum": [
          "720p",
          "4k",
          "webm",
          "gif",
          "prores-alpha",
          "tiktok",
          "reels",
          "youtube",
          "linkedin"
        ]
      }
    },
    "transparent": {
      "type": "boolean",
      "default": false,
      "description": "The film has no background (template.json may also set it); required by the prores-alpha export, which renders with ?alpha=1."
    },
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "description": "Per-format deep-merge applied last. May not override template, page, formats, audio, duration, bpm, loop, variants, cutdowns, exports, clips, fonts or transparent (enforced in resolveProject); one timeline and one mix are shared by every format.",
      "properties": {
        "9x16": {
          "type": "object"
        },
        "1x1": {
          "type": "object"
        },
        "4x5": {
          "type": "object"
        },
        "16x9": {
          "type": "object"
        }
      }
    }
  }
}
